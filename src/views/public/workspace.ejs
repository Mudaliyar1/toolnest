<% layout('layouts/main') -%>
<%
  const durationToMs = (val, unit) => {
    const v = Number(val) || 0;
    if (unit === 'seconds') return v * 1000;
    if (unit === 'hours') return v * 60 * 60 * 1000;
    return v * 60 * 1000;
  };
  const downloadRetentionMs = durationToMs(systemSettings.downloadRetentionValue || 2, systemSettings.downloadRetentionUnit || 'minutes');
%>
<section class="container py-5 py-lg-6" id="workspace-container" data-download-retention-ms="<%= downloadRetentionMs %>" data-server-now="<%= new Date().toISOString() %>">
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
          <p class="text-uppercase small fw-bold text-primary mb-2" style="letter-spacing: 0.1em;">Anonymous workspace</p>
          <h1 class="display-6 fw-bold text-dark mb-2" style="letter-spacing: -0.02em;">My Workspace</h1>
          <p class="text-secondary mb-0">Temporary anonymous workspace for uploads, processed files, and cleanup tracking.</p>
        </div>
      </div>

      <div class="row g-4 mb-5">
        <div class="col-md-4">
          <div class="p-3 bg-light border-0 shadow-sm rounded-3 h-100" style="border: 1px solid rgba(226, 232, 240, 0.6) !important;">
            <div class="small text-secondary mb-1">Workspace ID</div>
            <div class="fw-bold text-break text-dark font-monospace"><%= workspace ? workspace.workspaceId : 'Pending' %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-3 bg-light border-0 shadow-sm rounded-3 h-100" style="border: 1px solid rgba(226, 232, 240, 0.6) !important;">
            <div class="small text-secondary mb-1">Remaining Time</div>
            <div id="countdown-timer" class="fw-bold text-primary fs-5" data-expires="<%= workspace ? workspace.expiresAt : '' %>">
              <%= workspace ? `${workspace.remainingMinutes} min` : 'Pending' %>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-3 bg-light border-0 shadow-sm rounded-3 h-100" style="border: 1px solid rgba(226, 232, 240, 0.6) !important;">
            <div class="small text-secondary mb-1">Files</div>
            <div class="fw-bold text-dark fs-5"><%= (files.uploaded || []).length + (files.processed || []).length %></div>
          </div>
        </div>
      </div>

      <div class="row g-4 mt-1">
        <div class="col-lg-6">
          <h2 class="h5 fw-bold text-dark mb-3">Uploaded Files</h2>
          <div class="d-grid gap-3">
            <% if ((files.uploaded || []).length === 0) { %>
              <div class="text-center p-4 border border-dashed rounded-3 text-secondary small bg-light">
                No files uploaded yet. Run a tool to upload files here.
              </div>
            <% } %>
            <% (files.uploaded || []).forEach((file) => { %>
              <div class="border-0 shadow-sm p-3 file-card rounded-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div class="d-flex align-items-start gap-3">
                    <% if (file.fileType.includes('pdf')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.15);">
                        <path d="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 2V8H20" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <text x="7" y="17" fill="#ef4444" font-family="'Inter', sans-serif" font-size="6.5" font-weight="bold">PDF</text>
                      </svg>
                    <% } else if (file.fileType.includes('image')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.15);">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="#8b5cf6" stroke-width="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5" fill="#8b5cf6"/>
                        <path d="M21 15L16 10L5 21" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    <% } else if (file.fileType.includes('video')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.15);">
                        <path d="M23 7L16 12L23 17V7Z" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    <% } else if (file.fileType.includes('audio')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.15);">
                        <path d="M9 18V5L21 3V16" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="6" cy="18" r="3" stroke="#06b6d4" stroke-width="2"/>
                        <circle cx="18" cy="16" r="3" stroke="#06b6d4" stroke-width="2"/>
                      </svg>
                    <% } else { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.15);">
                        <path d="M13 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V9L13 2Z" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13 2V9H20" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    <% } %>
                    
                    <div class="flex-grow-1 min-w-0">
                      <div class="fw-bold text-dark text-break mb-1" style="font-size: 0.95rem; letter-spacing: -0.01em;"><%= file.processedName %></div>
                      <div class="small text-secondary"><%= file.fileType %> &middot; <%= file.fileSize %> bytes &middot; <span class="file-local-time" data-time="<%= file.uploadTime.toISOString() %>"></span></div>
                      <div class="file-countdown-timer small text-warning fw-semibold mt-2" data-file-id="<%= file._id %>" data-expires="<%= file.expireTime %>">Expires in: --:--</div>
                    </div>
                  </div>
                  <form method="post" action="/workspace/files/<%= file._id %>/delete" class="ms-auto flex-shrink-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="col-lg-6">
          <h2 class="h5 fw-bold text-dark mb-3">Processed Files</h2>
          <div class="d-grid gap-3">
            <% if ((files.processed || []).length === 0) { %>
              <div class="text-center p-4 border border-dashed rounded-3 text-secondary small bg-light">
                No files processed yet. Execute a tool to see output files.
              </div>
            <% } %>
            <% (files.processed || []).forEach((file) => { %>
              <div class="border-0 shadow-sm p-3 file-card rounded-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                  <div class="d-flex align-items-start gap-3 flex-grow-1 min-w-0">
                    <% if (file.fileType.includes('pdf')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.15);">
                        <path d="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 2V8H20" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <text x="7" y="17" fill="#ef4444" font-family="'Inter', sans-serif" font-size="6.5" font-weight="bold">PDF</text>
                      </svg>
                    <% } else if (file.fileType.includes('image')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.15);">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="#8b5cf6" stroke-width="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5" fill="#8b5cf6"/>
                        <path d="M21 15L16 10L5 21" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    <% } else if (file.fileType.includes('video')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.15);">
                        <path d="M23 7L16 12L23 17V7Z" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    <% } else if (file.fileType.includes('audio')) { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.15);">
                        <path d="M9 18V5L21 3V16" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="6" cy="18" r="3" stroke="#06b6d4" stroke-width="2"/>
                        <circle cx="18" cy="16" r="3" stroke="#06b6d4" stroke-width="2"/>
                      </svg>
                    <% } else { %>
                      <svg class="flex-shrink-0" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px; padding: 6px; background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.15);">
                        <path d="M13 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V9L13 2Z" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13 2V9H20" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    <% } %>
                    
                    <div class="flex-grow-1 min-w-0">
                      <div class="fw-bold text-dark text-break mb-1" style="font-size: 0.95rem; letter-spacing: -0.01em;"><%= file.processedName %></div>
                      <div class="small text-secondary"><%= file.fileType %> &middot; <%= file.fileSize %> bytes &middot; <span class="file-local-time" data-time="<%= file.uploadTime.toISOString() %>"></span></div>
                      <div class="file-countdown-timer small text-warning fw-semibold mt-2" data-file-id="<%= file._id %>" data-expires="<%= file.expireTime %>">Expires in: --:--</div>
                    </div>
                  </div>
                  <div class="d-flex gap-2 flex-shrink-0 ms-auto">
                    <a href="/workspace/files/<%= file._id %>/download" class="btn btn-outline-primary btn-sm download-btn" data-file-id="<%= file._id %>" download="<%= file.processedName %>">Download</a>
                    <form method="post" action="/workspace/files/<%= file._id %>/delete">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/workspace.js" defer></script>
